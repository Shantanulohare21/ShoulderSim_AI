# Application Configuration
APP_NAME=ShoulderSim AI
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=1

# Database
DATABASE_URL=postgresql://shouldersim:shouldersim_password@postgres:5432/shouldersim
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# TimescaleDB (time-series data)
TIMESCALEDB_URL=postgresql://shouldersim:shouldersim_password@timescaledb:5432/shouldersim_ts

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_CELERY_DB=1

# Security
SECRET_KEY=your-secret-key-change-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Storage (S3/MinIO)
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=shouldersim-dicom
S3_USE_SSL=false

# AI/ML
MLFLOW_TRACKING_URI=http://mlflow:5000
MODEL_REGISTRY_PATH=./models

# Monitoring
SENTRY_DSN=
PROMETHEUS_ENABLED=true

# DICOM Processing
MONAI_CACHE_DIR=./cache/monai
SEGMENTATION_MODEL_PATH=./models/segmentation

# Simulation
FENICSX_MESH_DIR=./cache/meshes
SIMULATION_TIMEOUT_SECONDS=3600
